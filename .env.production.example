# Canonical hosted Software Oath origin. The dashboard and API share one origin.
PORT=8787
SOFTWARE_OATH_PUBLIC_URL=https://app.softwareoath.com
SOFTWARE_OATH_DASHBOARD_ORIGIN=https://app.softwareoath.com

# Use managed PostgreSQL and encrypted persistent artifact storage in production.
DATABASE_URL=postgresql://software_oath:<password>@<postgres-host>:5432/software_oath
SOFTWARE_OATH_DB_SSL=require
SOFTWARE_OATH_ARTIFACT_PATH=/data/artifacts
SOFTWARE_OATH_STATIC_PATH=dist

# GitHub App and owner sign-in.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_ENCRYPTED=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SOFTWARE_OATH_GITHUB_CONFIG=/data/github-app.json

# Generate each secret independently. Never reuse a value.
SOFTWARE_OATH_APPROVAL_TOKEN=
SOFTWARE_OATH_SESSION_SECRET=
SOFTWARE_OATH_MASTER_KEY=

# Signed repair and final-attestation receipts.
SOFTWARE_OATH_RECEIPT_KEY_ID=
SOFTWARE_OATH_RECEIPT_PRIVATE_KEY=
SOFTWARE_OATH_RECEIPT_PUBLIC_KEYS={}

# Optional repository default and isolated runner image.
SOFTWARE_OATH_REPOSITORY=
SOFTWARE_OATH_RUNNER_IMAGE=
SOFTWARE_OATH_RUNNER_VOLUME=
SOFTWARE_OATH_RUNNER_WORKSPACE_ROOT=
SOFTWARE_OATH_RUNNER_BROKER_URL=
SOFTWARE_OATH_RUNNER_BROKER_TOKEN=

# Legacy adapter only; leave empty for normal stewardship.
SENTRY_CLIENT_SECRET=
