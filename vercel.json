{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/queue-runs.ts": {
      "maxDuration": 800,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "software-oath-runs",
          "retryAfterSeconds": 30
        }
      ]
    },
    "api/cron.ts": {
      "maxDuration": 60
    },
    "api/control-plane.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/control-plane"
    }
  ],
    "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
